<?xml version="1.0" encoding="UTF-8"?>
<!-- Client-only: aggregate every error code in driver.json instead of printing
     a Java stack trace for each expected overload rejection. Node logs unchanged. -->
<Configuration status="ERROR">
  <Appenders><Console name="Console" target="SYSTEM_ERR"><PatternLayout pattern="%d %p %c %m%n"/></Console></Appenders>
  <Loggers><Root level="fatal"><AppenderRef ref="Console"/></Root></Loggers>
</Configuration>
