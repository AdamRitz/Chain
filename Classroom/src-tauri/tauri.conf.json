{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chain Classroom",
  "version": "0.1.1",
  "identifier": "edu.chain.classroom",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/": "runtime/"
    },
    "shortDescription": "Chain blockchain teaching laboratory",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "template": "installer/OneClick.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
